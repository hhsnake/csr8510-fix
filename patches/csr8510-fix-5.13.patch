+static void btusb_reset(struct hci_dev *hdev)
+{
+	struct btusb_data *data = hci_get_drvdata(hdev);
+	int err;
+
+	/* This is not an unbalanced PM reference since the device will reset */
+	err = usb_autopm_get_interface(data->intf);
+	if (err) {
+		bt_dev_err(hdev, "Failed usb_autopm_get_interface: %d", err);
+		return;
+	}
+
+	bt_dev_err(hdev, "Resetting usb device.");
+	usb_queue_reset_device(data->intf);
+}
+
+static void btusb_csr_cmd_timeout(struct hci_dev *hdev)
+{
+	struct btusb_data *data = hci_get_drvdata(hdev);
+
+	if (!test_bit(BTUSB_FAKE_CSR, &data->flags))
+		return;
+
+	bt_dev_err(hdev, "CSR: command timeout recovery attempt %u",
+		   data->cmd_timeout_cnt + 1);
+
+	if (test_and_set_bit(BTUSB_HW_RESET_ACTIVE, &data->flags)) {
+		bt_dev_err(hdev, "CSR: last reset still active, not resetting again");
+		return;
+	}
+
+	btusb_reset(hdev);
+}
+
+/* A dongle that answers nothing at all makes the core close the device and
+ * cancel cmd_timer before cmd_timeout ever runs, so drive recovery from close:
+ * no HCI event between open and close means reset. Rate-limited module-wide -
+ * a reset rebinds the driver, so per-device state cannot stop a loop.
+ */
+static void btusb_csr_reset_on_silent_close(struct hci_dev *hdev)
+{
+	static unsigned long btusb_csr_last_silent_reset;
+	struct btusb_data *data = hci_get_drvdata(hdev);
+
+	if (!test_bit(BTUSB_FAKE_CSR, &data->flags) ||
+	    test_bit(BTUSB_CSR_EVENT_SEEN, &data->flags))
+		return;
+
+	if (btusb_csr_last_silent_reset &&
+	    time_before(jiffies, btusb_csr_last_silent_reset + 30 * HZ)) {
+		bt_dev_warn(hdev, "CSR: silent close, skipping usb reset (rate-limited)");
+		return;
+	}
+
+	if (test_and_set_bit(BTUSB_HW_RESET_ACTIVE, &data->flags)) {
+		bt_dev_warn(hdev, "CSR: silent close, but reset already active");
+		return;
+	}
+
+	btusb_csr_last_silent_reset = jiffies;
+	bt_dev_warn(hdev, "CSR: no HCI events since open; queueing usb reset");
+	btusb_reset(hdev);
+}
