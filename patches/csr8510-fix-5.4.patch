+/* These clones advertise LE but fail every LE command (0x2005, 0x200b: -EPIPE),
+ * which aborts the dual-mode discovery desktop stacks start with before it
+ * reaches BR/EDR. Clear the LE bits in the local-features response so the core
+ * comes up BR/EDR-only, like "ControllerMode = bredr" in bluetoothd.
+ */
+static void btusb_csr_hide_le(struct hci_dev *hdev, struct sk_buff *skb,
+			      u16 opcode)
+{
+	struct hci_rp_read_local_ext_features *ep;
+	struct hci_rp_read_local_features *fp;
+	size_t off = sizeof(struct hci_event_hdr) +
+		     sizeof(struct hci_ev_cmd_complete);
+	void *rp = skb->data + off;
+	size_t rlen = skb->len - off;
+
+	if (opcode == HCI_OP_READ_LOCAL_FEATURES) {
+		if (rlen < sizeof(*fp))
+			return;
+		fp = rp;
+		if (fp->status || !(fp->features[4] & LMP_LE))
+			return;
+		fp->features[4] &= ~LMP_LE;
+		bt_dev_info(hdev,
+			    "CSR: hiding advertised but non-functional LE support");
+	} else {
+		if (rlen < sizeof(*ep))
+			return;
+		ep = rp;
+		if (ep->status || ep->page != 0x01)
+			return;
+		ep->features[0] &= ~(LMP_HOST_LE | LMP_HOST_LE_BREDR);
+	}
+}
+
+/* Pad the undersized command-complete payloads these clones return, so the
+ * core parser stays in sync (5.4 has no BROKEN_READ_* quirks to skip them):
+ *   HCI_OP_READ_VOICE_SETTING  (0x0c25): 2 bytes instead of 3
+ *   HCI_OP_READ_TX_POWER       (0x0c2d): 3 bytes instead of 4
+ *   HCI_OP_READ_PAGE_SCAN_TYPE (0x0c46): 1 byte  instead of 2
+ */
+static int btusb_recv_event_csr(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct hci_event_hdr *hdr = (void *)skb->data;
+	struct hci_ev_cmd_complete *cc;
+	u16 opcode;
+	u8 expected_plen;
+
+	if (skb->len < sizeof(*hdr) + sizeof(*cc) ||
+	    hdr->evt != HCI_EV_CMD_COMPLETE)
+		goto done;
+
+	cc = (void *)(skb->data + sizeof(*hdr));
+	opcode = le16_to_cpu(cc->opcode);
+
+	switch (opcode) {
+	case HCI_OP_READ_LOCAL_FEATURES:
+	case HCI_OP_READ_LOCAL_EXT_FEATURES:
+		if (csr_disable_le)
+			btusb_csr_hide_le(hdev, skb, opcode);
+		goto done;
+	case HCI_OP_READ_VOICE_SETTING:
+		expected_plen = sizeof(*cc) + 3; /* status + __le16 */
+		break;
+	case HCI_OP_READ_TX_POWER:
+		expected_plen = sizeof(*cc) + 4; /* status + __le16 handle + s8 */
+		break;
+	case HCI_OP_READ_PAGE_SCAN_TYPE:
+		expected_plen = sizeof(*cc) + 2; /* status + u8 type */
+		break;
+	default:
+		goto done;
+	}
+
+	if (hdr->plen == expected_plen - 1 && skb_tailroom(skb) >= 1) {
+		bt_dev_dbg(hdev, "CSR: padding short response for opcode 0x%04x", opcode);
+		skb_put_u8(skb, 0x00);
+		hdr->plen++;
+	}
+
+done:
+	return hci_recv_frame(hdev, skb);
+}
