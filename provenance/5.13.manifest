# Provenance manifest — src/5.13 is a GENERATED artifact, do not edit by hand.
#
#   src/5.13/  =  pristine kernel files @ <commit>  +  patches/csr8510-fix-5.13.patch
#
# The trust anchor is the sha256 of each file's content, NOT the download URL.
# Any mirror serving the same bytes is acceptable; tools/regen.sh verifies the
# hash before use and tools/verify.sh proves src/5.13 equals the result. This
# is what lets a reviewer confirm nothing was slipped into the vendored source.
#
# This variant exists because btintel's ABI changed in 5.13: btintel_download_firmware()
# gained an intel_version argument and btintel_version_info() changed its return type,
# so src/5.4 would call them with the wrong signature (MODVERSIONS does not catch it —
# modpost copies the CRC from the kernel's Module.symvers by name). src/5.15 does not
# fit either: it needs btintel_configure_setup/_bootup/_secure_send_result, which only
# exist from 5.15 on.

variant  5.13
tag      v5.13
commit   62fb9874f5da54fdb243003b386128037319b219
patch    patches/csr8510-fix-5.13.patch

# Download mirrors (raw bytes), tried in order. {commit} and {path} substituted.
mirror   https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/plain/{path}?id={commit}
mirror   https://raw.githubusercontent.com/torvalds/linux/{commit}/{path}

