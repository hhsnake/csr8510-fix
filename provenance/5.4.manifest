# Provenance manifest — src/5.4 is a GENERATED artifact, do not edit by hand.
#
#   src/5.4/  =  pristine kernel files @ <commit>  +  patches/csr8510-fix-5.4.patch
#
# The trust anchor is the sha256 of each file's content, NOT the download URL.
# Any mirror serving the same bytes is acceptable; tools/regen.sh verifies the
# hash before use and tools/verify.sh proves src/5.4 equals the result. This
# is what lets a reviewer confirm nothing was slipped into the vendored source.

variant  5.4
tag      v5.4
commit   219d54332a09e8d8741c1e1982f5eae56099de85
patch    patches/csr8510-fix-5.4.patch

# Download mirrors (raw bytes), tried in order. {commit} and {path} substituted.
# Release tags never move and are mirrored widely; if all mirrors are gone, a
# local clone still works:  KERNEL_GIT=/path/to/linux.git tools/regen.sh 5.4
mirror   https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/plain/{path}?id={commit}
mirror   https://raw.githubusercontent.com/torvalds/linux/{commit}/{path}

# file  <sha256>  <path-in-kernel-tree>  <dest-in-src>  <apply-patch?>
file  5ef78825e99b70eb38229e7a4594fdc5da60096f82ec8db4a0298e5f4b630c3a  drivers/bluetooth/btusb.c   btusb.c    yes
file  ea991c853fcb474712ff35a3a9e2c215aafa4cb461cd59864d3732e6947f8db5  drivers/bluetooth/btbcm.h   btbcm.h    no
file  cdd8126ed32fb8423735b6356a6556f7825a301fee5c03fa3927abeaa1f2038c  drivers/bluetooth/btintel.h btintel.h  no
file  ec8eab2578a128ab920879001dd84bb35a86b1af01ce3c84f8f13988e9500c2c  drivers/bluetooth/btrtl.h   btrtl.h    no
